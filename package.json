    "icons": "tsx tools/make-icons.ts",
    "screens": "tsx tools/make-screens.ts",
    "test:e2e": "tsx tools/e2e/run.ts",
    "test:offline": "tsx tools/e2e/offline.ts"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/yeseva-one": "^5.3.0",
    "lit-html": "^3.3.3"
